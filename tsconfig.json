{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "@obsidian-typings/obsidian-public-latest",
      "@total-typescript/ts-reset",
      "node"
    ]
  },
  "include": [
    "./commitlint.config.ts",
    "./eslint.config.mts",
    "./packages/*/src/**/@types/**/*.d.ts",
    "./scripts/**/*.ts",
    "./vitest.config.ts"
  ],
  "exclude": [
    "./scripts/docs-gen/**/*.ts"
  ]
}
